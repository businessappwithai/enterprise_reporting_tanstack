# ==========================================
# STAGE 1: Builder (CPU-only compilation)
# ==========================================
FROM ubuntu:22.04 AS builder

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git build-essential cmake curl wget libgomp1 pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone and compile llama.cpp (CPU-only, avoids CUDA issues)
RUN git clone https://github.com/ggml-org/llama.cpp.git && \
    cd llama.cpp && \
    mkdir build && cd build && \
    cmake -DGGML_CPU=ON .. && \
    cmake --build . --config Release -j4 && \
    cp bin/llama-server /build/llama-server || true

# ==========================================
# STAGE 2: Runtime (minimal base)
# ==========================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libgomp1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy llama-server from builder
COPY --from=builder /build/llama-server /app/llama-server

# Create models directory
RUN mkdir -p /app/models

# Download SLM-SQL-Base-0.6B GGUF model (quantized for efficiency)
# Using 3-bit quantization for smallest footprint
RUN curl -L -o /app/models/slm-sql-base-0.6b.Q3_K_M.gguf \
    "https://huggingface.co/mradermacher/SLM-SQL-Base-0.6B-GGUF/resolve/main/SLM-SQL-Base-0.6B.Q3_K_M.gguf" || \
    echo "Model download failed - will need to be mounted or downloaded manually"

# Expose llama.cpp server port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start llama.cpp server optimized for Text-to-SQL
CMD ["/app/llama-server", \
     "-m", "/app/models/slm-sql-base-0.6b.Q3_K_M.gguf", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "-c", "512", \
     "-n", "256", \
     "--gpu-layers", "35", \
     "--batch-size", "128"]
