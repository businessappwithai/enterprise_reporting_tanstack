# ==========================================
# Llama.cpp Server - Text-to-SQL Engine
# Using pre-built binaries to avoid compilation issues
# ==========================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libgomp1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download and extract pre-built llama-server binary for Ubuntu 22.04
# Using a known working build
RUN mkdir -p /app && \
    curl -L -o /tmp/llama-server-ubuntu.tar.gz "https://github.com/ggml-org/llama.cpp/releases/download/b4016/llama-server-b4016-ubuntu-x86_64.tar.gz" && \
    tar -xzf /tmp/llama-server-ubuntu.tar.gz -C /app && \
    chmod +x /app/llama-server && \
    rm /tmp/llama-server-ubuntu.tar.gz || \
    echo "Using fallback: building from source" && \
    apt-get update && apt-get install -y git build-essential cmake && \
    git clone https://github.com/ggml-org/llama.cpp.git /tmp/llama.cpp && \
    cd /tmp/llama.cpp && \
    mkdir build && cd build && \
    cmake -DGGML_CPU=ON .. && \
    cmake --build . --config Release -j2 && \
    cp bin/llama-server /app/llama-server && \
    rm -rf /tmp/llama.cpp

# Create models directory
RUN mkdir -p /app/models

# Download SLM-SQL-Base-0.6B GGUF model (quantized for efficiency)
# Using 3-bit quantization for smallest footprint
RUN curl -L -o /app/models/slm-sql-base-0.6b.Q3_K_M.gguf \
    "https://huggingface.co/mradermacher/SLM-SQL-Base-0.6B-GGUF/resolve/main/SLM-SQL-Base-0.6B.Q3_K_M.gguf" || \
    echo "Model download failed - will need to be mounted or downloaded manually"

# Expose llama.cpp server port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start llama.cpp server optimized for Text-to-SQL
CMD ["/app/llama-server", \
     "-m", "/app/models/slm-sql-base-0.6b.Q3_K_M.gguf", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "-c", "512", \
     "-n", "256", \
     "--gpu-layers", "35", \
     "--batch-size", "128"]
