# Application
APP_URL=http://localhost:4050
NODE_ENV=development

# Authentication
AUTH_SECRET=your-auth-secret-key-here-min-32-chars

# MariaDB Configuration Database
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=enterprise_config
MARIADB_USER=enterprise
MARIADB_PASSWORD=your-secure-password
MARIADB_ROOT_PASSWORD=your-root-password

# Encryption key for data source credentials (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Background Job Processing (Trigger.dev)
TRIGGER_API_KEY=your-trigger-dev-api-key
TRIGGER_API_URL=http://localhost:3030
WORKER_CONCURRENCY=5

# Error Reporting
ERROR_REPORTING_EMAIL=admin@yourcompany.com

# SERVER-SIDE PAGINATION CONFIGURATION (CRITICAL)
# IMPORTANT: This application uses SERVER-SIDE PAGINATION ONLY
# All data queries MUST include LIMIT and OFFSET at the database level
# DO NOT fetch all data and paginate on the client - this will overload the server

# Default page size for all paginated server queries
DEFAULT_PAGE_SIZE=50

# Maximum page size allowed (user cannot exceed this limit)
MAX_PAGE_SIZE=1000

# Default page size for data tables (server-side fetching)
DATA_TABLE_PAGE_SIZE=100

# Default page size for report exports (server-side batch processing)
EXPORT_PAGE_SIZE=1000

# Virtual scrolling threshold - when to enable virtual scrolling with server-side data fetching
VIRTUAL_SCROLL_THRESHOLD=500

# Enable virtual scrolling for large datasets (works with server-side pagination)
ENABLE_VIRTUAL_SCROLLING=true

# =============================================================================
# AI MODEL CONFIGURATION
# Supports llama.cpp (local) and any OpenAI-compatible cloud API
# =============================================================================

# --- NL-to-SQL / Reasoning Model (chat completions) ---
# Used for converting natural language questions to SQL queries
# llama.cpp local example:
LLAMA_REASONING_URL=http://localhost:8080
LLAMA_REASONING_MODEL=qwen3.6
LLAMA_REASONING_API_KEY=none
# Cloud API example (OpenAI-compatible):
# LLAMA_REASONING_URL=https://api.openai.com
# LLAMA_REASONING_MODEL=gpt-4o
# LLAMA_REASONING_API_KEY=sk-proj-...
# Other OpenAI-compatible endpoints (Groq, Together, Fireworks, self-hosted vLLM):
# LLAMA_REASONING_URL=https://api.groq.com/openai
# LLAMA_REASONING_MODEL=llama-3.3-70b-versatile
# LLAMA_REASONING_API_KEY=gsk_...

# --- Voice-to-Text / Speech-to-Text Model (audio transcription) ---
# Used for speech recognition in the voice query interface
# llama.cpp local example (whisper.cpp with OpenAI-compatible API):
LLAMA_STT_URL=http://localhost:8081
LLAMA_STT_MODEL=Qwen3-ASR
LLAMA_STT_API_KEY=none
# Cloud API example (OpenAI Whisper):
# LLAMA_STT_URL=https://api.openai.com
# LLAMA_STT_MODEL=whisper-1
# LLAMA_STT_API_KEY=sk-proj-...

# --- Text-to-Speech Model (audio synthesis) ---
# Used for speaking query results in the voice interface
# llama.cpp local example:
LLAMA_TTS_URL=http://localhost:8083
LLAMA_TTS_MODEL=Qwen3-TTS
LLAMA_TTS_API_KEY=none
# Cloud API example (OpenAI TTS):
# LLAMA_TTS_URL=https://api.openai.com
# LLAMA_TTS_MODEL=tts-1
# LLAMA_TTS_API_KEY=sk-proj-...

# --- Mastra.ai Agent Orchestration ---
# Mastra.ai server for advanced NL-to-SQL agent pipeline
# The app passes AI model config above to Mastra per-request for dynamic routing
MASTRA_URL=http://localhost:4111
# MASTRA_API_KEY=your-mastra-api-key  # Required if Mastra server has auth enabled

# Legacy Ollama config (kept for backward compatibility)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=sqlcoder:7b

# Optional: External Data Source Examples
# POSTGRES_URL=postgresql://user:password@localhost:5432/database
# MYSQL_URL=mysql://user:password@localhost:3306/database
